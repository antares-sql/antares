{
  "name": "antares",
  "productName": "Antares",
  "version": "0.7.36-beta.0",
  "description": "A modern, fast and productivity driven SQL client with a focus in UX.",
  "license": "MIT",
  "repository": "https://github.com/antares-sql/antares.git",
  "scripts": {
    "debug": "npm run rebuild:electron && npm run debug-runner",
    "debug-runner": "node scripts/devRunner.js --remote-debug",
    "compile": "npm run compile:main && npm run compile:workers && npm run compile:renderer",
    "compile:main": "webpack --mode=production --config webpack.main.config.js",
    "compile:workers": "webpack --mode=production --config webpack.workers.config.js",
    "compile:renderer": "webpack --mode=production --config webpack.renderer.config.js",
    "build": "cross-env NODE_ENV=production npm run compile && electron-builder --publish never",
    "build:appx": "npm run build -- --win appx",
    "rebuild:electron": "rimraf ./dist && npm run devtools:install",
    "release": "standard-version",
    "release:beta": "npm run release -- --prerelease beta",
    "devtools:install": "node scripts/devtoolsInstaller",
    "translation:check": "ts-node ./scripts/translationCheck.ts",
    "test": "npm run test:unit",
    "test:unit": "node scripts/vitest.js run --project unit",
    "test:unit:watch": "node scripts/vitest.js --project unit",
    "test:integration": "node scripts/vitest.js run --project integration",
    "test:fixtures:record": "cross-env ANTARES_RECORD_FIXTURES=1 node scripts/vitest.js run --project integration tests/integration/introspection.record.spec.ts",
    "build:linux:docker": "docker compose -f docker/linux-build/compose.yml run --rm --build builder",
    "test:db:up": "docker compose -f docker/docker-compose.yml up -d --wait",
    "test:db:samples": "node scripts/sampleDatabases.js",
    "test:db:down": "docker compose -f docker/docker-compose.yml down -v",
    "test:e2e": "npm run compile && npm run test:e2e-dry",
    "test:e2e-dry": "xvfb-maybe -- playwright test app.spec",
    "lint": "eslint . --ext .js,.ts,.vue && stylelint \"./src/**/*.{css,scss,sass,vue}\"",
    "lint:fix": "eslint . --ext .js,.ts,.vue --fix && stylelint \"./src/**/*.{css,scss,sass,vue}\" --fix",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate",
    "prepare": "husky"
  },
  "author": "Fabio Di Stasio <info@fabiodistasio.it>",
  "main": "./dist/main.js",
  "antares": {
    "devtoolsId": "nhdogjmejiglipccpnnnanhbledajbpd"
  },
  "build": {
    "appId": "com.fabio286.antares",
    "artifactName": "${productName}-${version}-${os}_${arch}.${ext}",
    "asar": true,
    "buildDependenciesFromSource": false,
    "npmRebuild": false,
    "directories": {
      "output": "build",
      "buildResources": "assets"
    },
    "asarUnpack": "**\\*.{node,dll}",
    "files": [
      "dist/**/*",
      "node_modules",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": {
        "target": "default",
        "arch": [
          "x64"
        ]
      }
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/linux",
      "category": "Development"
    },
    "appImage": {
      "license": "./LICENSE",
      "category": "Development"
    },
    "nsis": {
      "license": "./LICENSE",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeader": "assets/icon.ico",
      "oneClick": false,
      "perMachine": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "appx": {
      "displayName": "Antares SQL",
      "backgroundColor": "transparent",
      "showNameOnTiles": true,
      "identityName": "62514FabioDiStasio.AntaresSQLClient",
      "publisher": "CN=1A2729ED-865C-41D2-9038-39AE2A63AA52",
      "applicationId": "FabioDiStasio.AntaresSQLClient"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "~6.20.4",
    "@codemirror/commands": "~6.11.1",
    "@codemirror/lang-html": "~6.4.12",
    "@codemirror/lang-json": "~6.0.2",
    "@codemirror/lang-markdown": "~6.5.2",
    "@codemirror/lang-sql": "~6.10.0",
    "@codemirror/lang-xml": "~6.1.0",
    "@codemirror/lang-yaml": "~6.1.3",
    "@codemirror/language": "~6.13.1",
    "@codemirror/legacy-modes": "~6.5.5",
    "@codemirror/search": "~6.7.2",
    "@codemirror/state": "~6.7.6",
    "@codemirror/view": "~6.43.15",
    "@electron/remote": "~2.1.4",
    "@fabio286/ssh2-promise": "~1.0.4-b",
    "@faker-js/faker": "~6.1.2",
    "@jamescoyle/vue-icon": "~0.1.2",
    "@lezer/highlight": "~1.2.5",
    "@mdi/js": "~7.2.96",
    "@turf/helpers": "~6.5.0",
    "@vue/compiler-sfc": "~3.5.45",
    "@vueuse/core": "~15.0.0",
    "babel-loader": "~8.2.3",
    "better-sqlite3": "~13.2.0",
    "chalk": "~4.1.2",
    "ciaplu": "^2.2.0",
    "cross-env": "~7.0.2",
    "css-loader": "~7.1.2",
    "electron-log": "~5.4.4",
    "electron-store": "~12.0.0",
    "electron-updater": "~6.8.11",
    "electron-window-state": "~5.0.3",
    "encoding": "~0.1.13",
    "file-loader": "~6.2.0",
    "floating-vue": "~5.4.0",
    "html-webpack-plugin": "~5.5.0",
    "json2php": "~0.0.7",
    "leaflet": "~1.7.1",
    "marked": "~12.0.0",
    "mini-css-extract-plugin": "~2.4.5",
    "moment": "~2.30.1",
    "mysql2": "~3.9.7",
    "node-firebird": "~2.21.0",
    "node-loader": "~2.0.0",
    "pg": "~8.23.1",
    "pg-query-stream": "~4.17.1",
    "pgsql-ast-parser": "~7.2.1",
    "pinia": "~4.1.0",
    "postcss-html": "~1.5.0",
    "progress-webpack-plugin": "~1.0.12",
    "rimraf": "~3.0.2",
    "sass": "~1.42.1",
    "sass-loader": "~12.3.0",
    "source-map-support": "~0.5.20",
    "spectre.css": "~0.5.9",
    "sql-formatter": "~13.0.0",
    "sql-highlight": "~4.4.0",
    "style-loader": "~3.3.1",
    "tree-kill": "~1.2.2",
    "ts-loader": "~9.2.8",
    "typescript": "~5.8.3",
    "unzip-crx-3": "~0.2.0",
    "v-mask": "~2.3.0",
    "vue": "~3.5.45",
    "vue-i18n": "~11.4.22",
    "vue-loader": "~17.4.2",
    "vuedraggable": "~4.1.0",
    "webpack": "^5.91.0",
    "webpack-cli": "~4.9.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "~7.15.7",
    "@babel/preset-env": "~7.15.8",
    "@babel/preset-typescript": "~7.16.7",
    "@commitlint/cli": "~19.0.3",
    "@commitlint/config-conventional": "~19.0.3",
    "@playwright/test": "~1.65.1",
    "@types/better-sqlite3": "~9.6.0",
    "@types/leaflet": "~1.7.9",
    "@types/marked": "~4.0.7",
    "@types/node": "~24.9.0",
    "@types/pg": "~8.23.1",
    "@types/ssh2": "~1.11.6",
    "@typescript-eslint/eslint-plugin": "~5.18.0",
    "@typescript-eslint/parser": "~5.18.0",
    "all-contributors-cli": "~6.20.0",
    "electron": "~45.3.4",
    "electron-builder": "~26.18.0",
    "eslint": "~7.32.0",
    "eslint-config-standard": "~16.0.3",
    "eslint-plugin-import": "~2.24.2",
    "eslint-plugin-node": "~11.1.0",
    "eslint-plugin-promise": "~5.2.0",
    "eslint-plugin-simple-import-sort": "~10.0.0",
    "eslint-plugin-vue": "~8.0.3",
    "husky": "~9.0.11",
    "playwright": "~1.65.1",
    "playwright-core": "~1.65.1",
    "standard-version": "~9.3.1",
    "stylelint": "^15.11.0",
    "stylelint-config-recommended-vue": "~1.5.0",
    "stylelint-config-standard": "~34.0.0",
    "stylelint-scss": "~5.3.0",
    "ts-node": "~10.9.1",
    "vitest": "~3.2.7",
    "vue-eslint-parser": "~8.3.0",
    "webpack-dev-server": "~4.11.1",
    "xvfb-maybe": "~0.2.1"
  },
  "optionalDependencies": {
    "dmg-license": "~1.0.11"
  }
}
