{
  "include": [
    "./tests/**/*",
    "./src/main/**/*",
    "./src/renderer/**/*",
    "./src/common/**/*"
  ],
  "compilerOptions": {
    "target": "es2021",
    "allowJs": true,
    "module": "CommonJS",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": false,
    "noImplicitAny": true,
    "jsx": "preserve",
    "types": [
      "node"
    ],
    "sourceMap": true,
    "outDir": "./dist/tsc",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "removeComments": true,
    "skipLibCheck": true,
    "paths": {
      "src/*": ["./src/*"],
      "common/*": ["./src/common/*"],
      "@/*": ["./src/renderer/*"],
      // conf (ESM-only, used by electron-store) exposes its types only through "exports"
      "conf": ["./node_modules/conf/dist/source/index.d.ts"]
    }
  }
}
